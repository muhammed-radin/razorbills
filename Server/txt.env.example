# Server — copy to .env and fill test values. NEVER commit real secrets.
ACTION_ACCESS_TOKEN=
SERVER_API_KEY=
CRYPTED=
CRYPTED_STRICT=
API_KEY=
MONGODB_URI=
ADMIN_USERNAME=
ADMIN_PASSWORD=
OWNER_EMAILS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ORIGINS=

# --- Commerce pricing (server-authoritative) ---
TAX_RATE_DEFAULT=18
FREE_SHIPPING_THRESHOLD=500
SHIPPING_FEE=50
COD_ENABLED=true
COD_FEE=30
COD_MIN_ORDER_VALUE=450
COD_MAX_ORDER_VALUE=3000

# Returns accepted within N days of delivery (server-enforced).
RETURN_WINDOW_DAYS=7

# --- Razorpay TEST MODE ONLY (https://dashboard.razorpay.com/app/keys) ---
# Use Test keys (rzp_test_*). Live payments must stay disabled in dev.
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER

# --- Shipmozo (https://shipping-api.com/app/api/v1) ---
# Official API PDF: public/Shipmozo API.pdf
# Swagger: https://shipping-api.com/api/v1?api-docs-v1.json
# Keys from Shipmozo panel profile (arrive after KYC approval).
# No sandbox exists; keep ALLOW_LIVE unset/false in dev so no real
# shipments are created. Base URL must NOT end with a trailing slash.
SHIPMOZO_API_BASE=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=PLACEHOLDER
SHIPMOZO_PRIVATE_KEY=PLACEHOLDER
SHIPMOZO_ALLOW_LIVE=false
SHIPMOZO_PICKUP_PINCODE=
SHIPMOZO_WAREHOUSE_ID=
SHIPMOZO_ORDER_TYPE=
SHIPMOZO_PRODUCT_CATEGORY=Other
SHIPMOZO_LENGTH_CM=10
SHIPMOZO_WIDTH_CM=20
SHIPMOZO_HEIGHT_CM=15
SHIPMOZO_TRACKING_BASE=https://panel.shipmozo.com/track-order
SHIPMOZO_WEBHOOK_SECRET=
