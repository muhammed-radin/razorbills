# Frontend — copy to .env and fill. NEVER commit real secrets.
VITE_API_ENDPOINT=http://localhost:3000
VITE_SERVER_API_KEY=
VITE_ACTION_ACESS_TOKEN=
VITE_CRYPTED=
VITE_CRYPTED_STRICT=

# Razorpay Checkout needs ONLY the public Key ID (test: rzp_test_*).
# NEVER put RAZORPAY_KEY_SECRET or webhook secrets in frontend env.
VITE_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER

# Firebase (existing usage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
